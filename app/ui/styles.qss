/* Тёмная тема Music Hub.

   Цвета не записаны здесь буквально: `@имя` подставляет app/ui/theme.py, где
   лежит единственная копия палитры. Так рисование вручную (полоса загрузки,
   заготовки строк, значки) и таблица стилей не расходятся.

   Фон задаём окнам, а не всем QWidget подряд: иначе каждый QLabel закрашивает
   свой прямоугольник и внутри карточек появляются «заплатки».

   Градиент синий→фуксия отведён главному действию, выбранному пункту меню и
   проигранной части полос. Если красить им всё, выделять становится нечего. */

QWidget {
    font-family: "Segoe UI", "Segoe UI Variable", sans-serif;
    font-size: 10pt;
    color: @text;
}

QMainWindow, QDialog {
    background-color: @bg;
}

/* Мини-плеер и карточка исполнителя — тоже отдельные окна, но
   QWidget с флагом Qt.Window под правило выше не попадает: без своего
   фона они показывали серую системную подложку */
QWidget#miniPlayer, QWidget#artistPage {
    background-color: @bg;
}

QLabel {
    background: transparent;
}

/* ---------- заголовки ---------- */
QLabel#h1 {
    font-size: 17pt;
    font-weight: 700;
    color: #ffffff;
}

QLabel#h2 {
    font-size: 11pt;
    font-weight: 600;
    color: #ffffff;
}

QLabel#hint {
    color: @text_dim;
    font-size: 9pt;
}

QLabel#sectionTitle {
    font-size: 10pt;
    font-weight: 700;
    color: @text;
}

/* Заголовок открытого раздела в верхней полосе */
QLabel#pageTitle {
    font-size: 14pt;
    font-weight: 700;
    color: #ffffff;
}

/* Ярлык над группой пунктов меню — не строка списка, отсюда мелкий
   приглушённый шрифт */
QLabel#navGroup {
    color: @text_mute;
    font-size: 8pt;
    font-weight: 700;
    padding: 0px 12px;
}

/* ---------- карточки и панели ---------- */
QFrame#card {
    background-color: @card;
    border: 1px solid @border;
    border-radius: @radius;
}

/* Вложенная карточка: на фоне обычной рамка выглядела бы двойной линией */
QFrame#cardInner {
    background-color: @raised;
    border: 1px solid @border_soft;
    border-radius: @radius_sm;
}

/* Боковое меню и верхняя полоса — части каркаса окна, поэтому отделены
   единственной линией, а не рамкой по кругу */
QFrame#sidebar {
    background-color: @surface;
    border: none;
    border-right: 1px solid @border_soft;
}

/* ---------- своя полоса заголовка ---------- */
QFrame#titleBar {
    background-color: @surface;
    border: none;
    border-bottom: 1px solid @border_soft;
}

QLabel#titleName {
    color: @text_dim;
    font-size: 9pt;
    font-weight: 600;
}

QPushButton#titleButton, QPushButton#titleClose {
    background: transparent;
    border: none;
    border-radius: 0;
    color: @text_dim;
    font-size: 11pt;
    padding: 0;
}

QPushButton#titleButton:hover {
    background-color: @hover;
    color: @text;
}

QPushButton#titleClose:hover {
    background-color: @danger;
    color: @text_on_accent;
}

QPushButton#titleButton:pressed {
    background-color: @raised;
}

QPushButton#titleClose:pressed {
    background-color: @danger_soft;
    color: @danger;
}

QFrame#topbar {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @border_soft;
}

QFrame#queuePanel {
    background-color: @surface;
    border: none;
    border-left: 1px solid @border_soft;
}

/* Сцена видео — такая же карточка, как остальные блоки, только с чёрным
   «экраном» внутри: кадр не должен светиться цветом интерфейса. */
QWidget#videoStage {
    background-color: @card;
    border: 1px solid @border_soft;
    border-radius: @radius;
}

QWidget#videoHeader {
    background: transparent;
}

QLabel#videoTitle {
    color: @text_dim;
    font-weight: 600;
}

QWidget#videoBody {
    background-color: #000000;
    border-bottom-left-radius: @radius;
    border-bottom-right-radius: @radius;
}

/* Подпись лежит поверх экрана, поэтому у неё свой фон: иначе на светлом кадре
   её было бы не прочитать */
QLabel#videoNote {
    color: @text_dim;
    background-color: #000000;
}

QWidget#header {
    background: transparent;
}

/* ---------- индикатор состояния ---------- */
QLabel#chip {
    border-radius: 14px;
    padding: 0;
}

QLabel#chip[state="ok"] {
    background-color: @ok_soft;
    color: @ok;
}

QLabel#chip[state="warn"] {
    background-color: @warn_soft;
    color: @warn;
}

QLabel#chip[state="off"] {
    background-color: @raised;
    color: @text_dim;
}

/* ---------- боковое меню ---------- */
QListWidget#nav {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#nav::item {
    padding: 9px 12px;
    margin: 0px 8px 2px 8px;
    border-radius: @radius_sm;
    color: @text_dim;
}

QListWidget#nav::item:hover {
    background-color: @hover;
    color: #ffffff;
}

/* Выбранный пункт — единственное место меню с градиентом: он же отмечает,
   где ты находишься */
QListWidget#nav::item:selected {
    background: @gradient;
    color: #ffffff;
}

/* Заголовок группы внутри списка: невыбираемая строка, набранная как ярлык */
QListWidget#nav::item:disabled {
    color: @text_mute;
    background: transparent;
    font-size: 8pt;
    font-weight: 700;
    padding: 12px 12px 4px 12px;
}

/* ---------- поля ввода ---------- */
QLineEdit, QComboBox, QAbstractSpinBox, QPlainTextEdit, QTextEdit {
    background-color: @raised;
    border: 1px solid @border;
    border-radius: @radius_sm;
    padding: 7px 10px;
    color: @text;
    selection-background-color: @accent;
    selection-color: #ffffff;
    /* Скруглённое поле в фокусе иначе обводится квадратом */
    outline: none;
}

QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover {
    border-color: @hover;
}

QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: @accent;
}

QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled {
    color: @text_mute;
    background-color: @card;
}

/* Строка поиска в верхней полосе: скруглена сильнее полей формы и оставляет
   слева место под значок */
QLineEdit#search {
    background-color: @raised;
    border: 1px solid @border;
    border-radius: 16px;
    padding: 6px 12px 6px 34px;
}

QLineEdit#search:focus {
    border-color: @accent;
    background-color: @card;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* Без стрелки список неотличим от обычного поля: своя, потому что системную
   на тёмном фоне не видно */
QComboBox::down-arrow {
    image: url(@icon_down);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: @raised;
    border: 1px solid @border;
    border-radius: @radius_sm;
    padding: 4px;
    selection-background-color: @accent;
    selection-color: #ffffff;
    outline: none;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    background-color: @hover;
    border: none;
    width: 20px;
    margin: 2px;
    border-radius: 4px;
}

QAbstractSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: @accent;
}

/* Кнопки были ровными серыми плитками: направление нажатия угадать нельзя */
QAbstractSpinBox::up-arrow {
    image: url(@icon_up);
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::down-arrow {
    image: url(@icon_down);
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::up-button:disabled, QAbstractSpinBox::down-button:disabled {
    background-color: @border_soft;
}

/* ---------- кнопки ---------- */
QPushButton {
    background-color: @accent;
    color: #ffffff;
    border: none;
    border-radius: @radius_sm;
    padding: 8px 16px;
    font-weight: 600;
    /* Прямоугольник фокуса система рисует поверх любой плашки, не считаясь
       со скруглением: кнопка после нажатия становится квадратной среди круглых */
    outline: none;
}

QPushButton:hover {
    background-color: @accent_hi;
}

QPushButton:pressed {
    background-color: @accent_lo;
}

QPushButton:disabled {
    background-color: @raised;
    color: @text_mute;
}

/* Главное действие страницы — одно на экран */
QPushButton#primary {
    background: @gradient;
    color: #ffffff;
}

QPushButton#primary:hover {
    background: @gradient_hi;
}

QPushButton#secondary {
    background-color: @raised;
    color: @text;
    border: 1px solid @border;
}

QPushButton#secondary:hover {
    background-color: @hover;
    border-color: @hover;
}

QPushButton#secondary:pressed {
    background-color: @card;
}

QPushButton#secondary:disabled {
    background-color: @card;
    color: @text_mute;
    border-color: @border_soft;
}

/* Переключатели разделов внутри страницы (Музыка / Видео / Всё и такие же
   в поиске и плейлистах). Это не вкладки QTabBar: содержимое одно и то же,
   меняется только источник, поэтому и вид спокойнее — плашка без рамки. */
QPushButton#tab {
    background-color: transparent;
    color: @text_dim;
    border: 1px solid transparent;
    border-radius: 15px;
    padding: 5px 14px;
    font-weight: 600;
    /* Иначе поверх скруглённой плашки система рисует прямоугольник фокуса,
       и нажатая вкладка выглядит квадратной среди круглых */
    outline: none;
}

QPushButton#tab:hover {
    color: #ffffff;
    background-color: @hover;
}

QPushButton#tab:checked {
    background-color: @accent_soft;
    color: @accent_text;
    border-color: @accent;
}

QPushButton#danger {
    background-color: @danger_soft;
    color: @danger;
    border: 1px solid transparent;
}

QPushButton#danger:hover {
    background-color: @danger;
    color: #ffffff;
}

QPushButton#danger:disabled {
    background-color: @card;
    color: @text_mute;
    border-color: @border_soft;
}

/* Свёрнутое пояснение открывается такой кнопкой. Выглядеть она должна ссылкой,
   а не кнопкой: обычная сплошная плашка внизу карточки перетягивала бы внимание
   с настроек на текст, который читают один раз. */
QPushButton#link {
    background: transparent;
    border: none;
    color: @accent_text;
    padding: 2px 0px;
    font-size: 9pt;
    font-weight: 600;
    text-align: left;
}

QPushButton#link:hover {
    color: #ffffff;
}

/* Кнопка-значок без подписи: подсветка только при наведении. Их в плеере и
   заголовках много, сплошные плашки дали бы рябь. */
QPushButton#iconBtn, QToolButton#iconBtn {
    background: transparent;
    border: none;
    border-radius: @radius_sm;
    padding: 6px;
    color: @text_dim;
}

QPushButton#iconBtn:hover, QToolButton#iconBtn:hover {
    background-color: @hover;
}

QPushButton#iconBtn:pressed, QToolButton#iconBtn:pressed {
    background-color: @card;
}

QPushButton#iconBtn:checked, QToolButton#iconBtn:checked {
    background-color: @accent_soft;
}

QPushButton#iconBtn:disabled {
    background: transparent;
}

/* «⋯» переполнения: она стоит в ряду обычных кнопок и означает то же самое —
   действие, которое можно нажать. Со стилем iconBtn (прозрачный фон, приглушённый
   цвет, без рамки) три точки читались как случайный мусор у края карточки: у
   соседних значков плеера кнопку выдаёт иконка, а здесь выдавать нечем. Берём вид
   соседей по строке — #secondary. */
QToolButton#overflowBtn {
    background-color: @raised;
    color: @text;
    border: 1px solid @border;
    border-radius: @radius_sm;
    padding: 6px;
}

QToolButton#overflowBtn:hover {
    background-color: @hover;
    border-color: @hover;
}

QToolButton#overflowBtn:pressed {
    background-color: @card;
}

/* Кнопка воспроизведения: круг с градиентом — единственная точка притяжения
   в полосе плеера, поэтому и крупнее соседей */
QPushButton#playBtn {
    background: @gradient;
    border: none;
    border-radius: 22px;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0px;
}

QPushButton#playBtn:hover {
    background: @gradient_hi;
}

QPushButton#playBtn:disabled {
    background: @raised;
}

/* ---------- списки и таблицы ---------- */
QTableView, QListWidget, QTreeView {
    background-color: @card;
    alternate-background-color: @card;
    border: 1px solid @border;
    border-radius: @radius;
    gridline-color: transparent;
    selection-background-color: @accent_soft;
    selection-color: #ffffff;
    outline: none;
}

QTableView::item, QListWidget::item, QTreeView::item {
    padding: 4px 8px;
    border: none;
}

QListWidget::item:hover, QTableView::item:hover, QTreeView::item:hover {
    background-color: @hover;
}

QHeaderView {
    background: transparent;
}

QHeaderView::section {
    background-color: @card;
    color: @text_dim;
    padding: 8px;
    border: none;
    border-bottom: 1px solid @border;
    font-weight: 600;
}

QHeaderView::section:hover {
    color: @text;
}

QTableCornerButton::section {
    background-color: @card;
    border: none;
}

/* Галочки в списках и настройках: системная отрисовка на тёмном фоне
   выглядит как светлое пятно, поэтому рисуем сами */
QListWidget::indicator, QCheckBox::indicator, QTableView::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid @hover;
    background-color: @raised;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QListWidget::indicator:hover, QCheckBox::indicator:hover,
QTableView::indicator:hover, QRadioButton::indicator:hover {
    border-color: @accent;
}

QListWidget::indicator:checked, QCheckBox::indicator:checked,
QTableView::indicator:checked, QRadioButton::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}

/* Залитый квадрат легко принять за «просто синий»: галочка внутри читается
   сразу и на снимке, и краем глаза */
QListWidget::indicator:checked, QCheckBox::indicator:checked,
QTableView::indicator:checked {
    image: url(@icon_check);
}

/* Выключенная галочка не должна гореть акцентом наравне с рабочими */
QCheckBox::indicator:checked:disabled, QListWidget::indicator:checked:disabled {
    background-color: @border;
    border-color: @border;
    image: url(@icon_check_off);
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: @border;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: @text_mute;
}

/* ---------- вкладки ---------- */
QTabWidget::pane {
    border: none;
    top: 0px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: @text_dim;
    padding: 6px 16px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-radius: 15px;
    /* Прямоугольник фокуса не считается со скруглением и торчит
       углами из-под плашки */
    outline: none;
}

QTabBar::tab:hover {
    background-color: @hover;
    color: #ffffff;
}

QTabBar::tab:selected {
    background-color: @accent_soft;
    border-color: @accent;
    color: #ffffff;
    font-weight: 600;
}

QTabBar::tab:focus {
    outline: none;
}

/* ---------- меню ---------- */
/* Без своих правил Qt рисует системное светлое меню: на тёмной теме оно
   вспыхивает белым прямоугольником посреди окна */
QMenu {
    background-color: @raised;
    border: 1px solid @border;
    border-radius: @radius_sm;
    padding: 6px;
}

QMenu::item {
    padding: 7px 22px 7px 14px;
    border-radius: 6px;
    color: @text;
}

QMenu::item:selected {
    background-color: @accent;
    color: #ffffff;
}

QMenu::item:disabled {
    color: @text_mute;
}

QMenu::separator {
    height: 1px;
    background-color: @border;
    margin: 5px 8px;
}

QMenu::icon {
    padding-left: 10px;
}

QMenuBar {
    background-color: @surface;
    color: @text;
}

QMenuBar::item:selected {
    background-color: @hover;
    border-radius: 6px;
}

/* ---------- разделитель панелей ---------- */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 8px;
}

QSplitter::handle:vertical {
    height: 8px;
}

QSplitter::handle:hover {
    background-color: @accent_soft;
}

/* ---------- прочее ---------- */
/* Область прокрутки — рамка вокруг настроек, а не отдельная панель:
   свой фон и рамку ей задавать нечего, иначе вкладка выглядит вложенной коробкой */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QToolTip {
    background-color: @raised;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 6px 8px;
}

QProgressBar {
    background-color: @raised;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: @text_dim;
}

QProgressBar::chunk {
    background: @gradient_bar;
    border-radius: 4px;
}

QMessageBox, QInputDialog, QFileDialog, QColorDialog {
    background-color: @bg;
}

QMessageBox QLabel, QInputDialog QLabel {
    color: @text;
}

/* Отмена рядом с подтверждением не должна выглядеть таким же призывом */
QDialogButtonBox QPushButton {
    min-width: 92px;
    background-color: @raised;
    color: @text;
    border: 1px solid @border;
}

QDialogButtonBox QPushButton:hover {
    background-color: @hover;
}

QDialogButtonBox QPushButton:default {
    background: @gradient;
    color: #ffffff;
    border: none;
}

QSlider::groove:horizontal {
    background: @border;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: @gradient_bar;
    height: 4px;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background: @border;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    width: 12px;
    height: 12px;
    margin: -5px 0px;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: @accent_text;
}

/* Выключенный источник в миксе не должен выглядеть работающим: без этого
   ползунок оставался в градиенте и спорил с прочерком вместо процентов */
QSlider::sub-page:horizontal:disabled {
    background: @border;
}

QSlider::handle:horizontal:disabled {
    background: @text_mute;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: @hover;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:horizontal {
    background: @hover;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:hover {
    background: @text_mute;
}

/* Стрелки скроллбара только съедают место и мешают попадать по ползунку */
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ---------- нижняя полоса плеера ---------- */
/* Отделяем её от содержимого страницы только верхней линией: рамка со всех
   сторон превращала бы полосу в ещё одну карточку и дробила окно. */
QFrame#nowPlaying {
    background-color: @surface;
    border: none;
    border-top: 1px solid @border_soft;
}

QLabel#npTitle {
    font-size: 10.5pt;
    font-weight: 600;
    color: #ffffff;
}

/* Панель у значка часов. Это отдельное окно без рамки системы, поэтому рамку и
   фон рисуем сами — иначе на светлом рабочем столе она сольётся с обоями. */
QWidget#trayFlyout {
    background-color: @card;
    border: 1px solid @border;
    border-radius: @radius_lg;
}

/* Отсчёт времени: моноширинные цифры, иначе полоса дёргается на каждой
   секунде, где меняется ширина знака */
QLabel#npTime {
    color: @text_dim;
    font-size: 8.5pt;
    font-family: "Consolas", "Cascadia Mono", monospace;
}

/* Обложка: подложка видна, пока картинка не загрузилась */
QLabel#cover {
    background-color: @raised;
    border-radius: @radius_sm;
}

QLabel#coverLarge {
    background-color: @raised;
    border-radius: @radius;
}

/* ---------- строка трека в списках музыки ---------- */
QFrame#trackRow {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @radius_sm;
}

QFrame#trackRow:hover {
    background-color: @hover;
    border-color: @border;
}

QFrame#trackRow[current="true"] {
    background-color: @accent_soft;
    border-color: @accent;
}

/* ---------- плитка подборки: обложка сверху, название снизу ---------- */
QToolButton#tile {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: @radius;
    padding: 6px 4px 8px 4px;
    color: @text_dim;
    font-size: 9pt;
}

QToolButton#tile:hover {
    background-color: @hover;
    border-color: @border;
    color: #ffffff;
}

QToolButton#tile:pressed {
    background-color: @accent_soft;
    border-color: @accent;
}

/* ---------- пустое состояние ---------- */
/* Пустой раздел без объяснения читается как сбой загрузки. Значок, строка
   «почему пусто» и кнопка «что сделать» занимают ту же дыру осмысленно. */
QLabel#emptyTitle {
    font-size: 11pt;
    font-weight: 600;
    color: @text;
}

QLabel#emptyText {
    color: @text_mute;
    font-size: 9pt;
}

/* Кнопка выхода из полного экрана: лежит поверх видео, поэтому свой фон */
QPushButton#videoExit {
    border: none;
    border-radius: 20px;
    background-color: rgba(0, 0, 0, 140);
}

QPushButton#videoExit:hover {
    background-color: rgba(0, 0, 0, 200);
}
